table _Measures
	lineageTag: d2e28628-f273-4dc2-82df-4cffff0bf3ad

	/// Counts people who picked the fear shown in the chart.
	/// Each person counts once. The total counts people, even if they picked several fears.
	/// Your life stage, gender, age and country filters apply. People with no fears picked are not included.
	measure 'Number of Respondents' =
			
			// Counts people who picked the fear shown in the chart.
			// Each person counts once. The total counts people, even if they picked several fears.
			DISTINCTCOUNT ( 'FactFearSelection'[ResponseKey] )
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: 447081b7-6edc-45bd-9a89-ebeaf7a5f904

	/// Counts fears people picked both as kids and as adults.
	/// If someone picked spiders in both lists, that counts as 1.
	/// If they picked spiders and heights in both lists, they add 2 to the total.
	measure 'Responses Where Fears Remained' =
			// Counts fears people picked both as kids and as adults.
			// If someone picked spiders in both lists, that counts as 1.
			CALCULATE (
			    COUNTROWS (
			        SUMMARIZE (
			            'FactFearSelection',
			            'FactFearSelection'[ResponseKey],
			            'FactFearSelection'[FearKey]
			        )
			    ),
			    KEEPFILTERS ( 'FactFearSelection'[IsRetained] = TRUE () )
			)
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: c0184d62-3af2-4688-9b8d-bbfadf289ae4

	/// Counts how many fears people picked.
	/// If someone picked three fears, they add 3 to the total.
	/// The same fear picked as a kid and as an adult counts twice when both stages are shown.
	measure 'Number of Fear Selections' =
			
			// Counts how many fears people picked.
			// If someone picked three fears, they add 3 to the total.
			COUNTROWS ( 'FactFearSelection' )
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: 80c875b7-033f-45e5-adc4-e71b3cc3c409

	/// Counts fears people picked as kids but not as adults.
	/// If someone picked two of these fears, they add 2 to the total.
	measure 'Childhood-Only Fear Selections' =
			
			// Counts fears people picked as kids but not as adults.
			// If someone picked two of these fears, they add 2 to the total.
			CALCULATE (
			    COUNTROWS (
			        SUMMARIZE (
			            'FactFearSelection',
			            'FactFearSelection'[ResponseKey],
			            'FactFearSelection'[FearKey]
			        )
			    ),
			    KEEPFILTERS ( 'FactFearSelection'[FearPattern] = "Childhood only" )
			)
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: 8ce0e342-4762-4e56-8094-fc6911269d99

	/// Counts fears people picked as adults but not as kids.
	/// If someone picked two of these fears, they add 2 to the total.
	measure 'Adult-Only Fear Selections' =
			
			// Counts fears people picked as adults but not as kids.
			// If someone picked two of these fears, they add 2 to the total.
			CALCULATE (
			    COUNTROWS (
			        SUMMARIZE (
			            'FactFearSelection',
			            'FactFearSelection'[ResponseKey],
			            'FactFearSelection'[FearKey]
			        )
			    ),
			    KEEPFILTERS ( 'FactFearSelection'[FearPattern] = "Adult only" )
			)
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: fb223b51-21d6-4697-9919-5f751467da3c

	/// Shows the percentage of people who picked a fear.
	/// For example, 20% means 1 in 5 people in the chosen group picked it.
	/// People with no fears picked are not included. People can pick several fears, so the percentages can add up to more than 100%.
	measure 'Respondents Selecting Fear (%)' =
			// Shows the percentage of people who picked a fear.
			// For example, 20% means 1 in 5 people in the chosen group picked it.
			VAR _respondentsSelectingFear =
			    [Number of Respondents]
			VAR _respondentsInGroup =
			    CALCULATE (
			        [Number of Respondents],
			        REMOVEFILTERS ( 'DimFear' )
			    )
			RETURN
			    DIVIDE ( _respondentsSelectingFear, _respondentsInGroup )
		formatString: 0.0%
		displayFolder: Starter Measures
		lineageTag: 6ae94dbc-0d87-40d1-b018-20ff3e1a3bd9

	/// Fear selections in the childhood list (285 overall).
	measure 'Picks Childhood' = CALCULATE ( [Number of Fear Selections], KEEPFILTERS ( FactFearSelection[LifeStage] = "Childhood" ) )
		formatString: #,##0
		displayFolder: P28
		lineageTag: ac000bf7-3051-5fc6-8a5f-1bb0240c3116

	/// Fear selections in the adult list (264 overall).
	measure 'Picks Adult' = CALCULATE ( [Number of Fear Selections], KEEPFILTERS ( FactFearSelection[LifeStage] = "Adult" ) )
		formatString: #,##0
		displayFolder: P28
		lineageTag: 036ef249-60c2-502d-9b97-ccd2b7f5f83d

	measure 'People Childhood' = CALCULATE ( [Number of Respondents], KEEPFILTERS ( FactFearSelection[LifeStage] = "Childhood" ) )
		formatString: #,##0
		displayFolder: P28
		lineageTag: 6cf5e447-1166-5daa-8045-09ea46485b77

	measure 'People Adult' = CALCULATE ( [Number of Respondents], KEEPFILTERS ( FactFearSelection[LifeStage] = "Adult" ) )
		formatString: #,##0
		displayFolder: P28
		lineageTag: 329e6d8a-e81c-577a-9605-5b3ea8a37bf7

	measure 'Change People' = [People Adult] - [People Childhood]
		formatString: +#,##0;-#,##0;0
		displayFolder: P28
		lineageTag: 5ba2ad8a-536c-598e-a509-29fdcc6cf8c3

	/// People who picked the fear as a child AND as an adult.
	measure 'People Kept' =
			CALCULATE (
			    [Number of Respondents],
			    KEEPFILTERS ( FactFearSelection[LifeStage] = "Childhood" ),
			    KEEPFILTERS ( FactFearSelection[IsRetained] = TRUE () )
			)
		formatString: #,##0
		displayFolder: P28
		lineageTag: 9af559b1-8a7a-5ff1-9bfc-1f36fa1f697f

	measure 'Retention Rate' = DIVIDE ( [Responses Where Fears Remained], [Picks Childhood] )
		formatString: 0.0%
		displayFolder: P28
		lineageTag: 04483bbc-fe16-570b-8923-49173944cd99

	measure 'Fear Retention %' = DIVIDE ( [People Kept], [People Childhood] )
		formatString: 0%
		displayFolder: P28
		lineageTag: 4a476866-cb95-57e8-ba16-8cef81c7bb87

	measure 'New Since Childhood' = [People Adult] - [People Kept]
		formatString: #,##0
		displayFolder: P28
		lineageTag: a3fe65fe-e10d-5b04-9703-4a9ee965dcf0

	/// Every response in the file (105), whether or not fears were picked.
	measure Respondents = CALCULATE ( DISTINCTCOUNT ( DataNightmare[ResponseKey] ), REMOVEFILTERS ( DataNightmare ) )
		formatString: #,##0
		displayFolder: P28
		lineageTag: f21873c3-eba5-53c7-a132-2476f1091246

	measure 'Share of Respondents' = DIVIDE ( [People Adult], [Respondents] )
		formatString: 0%
		displayFolder: P28
		lineageTag: 815477c9-8b15-5284-8d47-a312ed6aee1c

	/// 48 -> 14
	measure 'Beat1 Hero' =
			FORMAT ( CALCULATE ( [People Childhood], DimFear[Beat] = 1 ) + 0, "0" ) & " → "
			    & FORMAT ( CALCULATE ( [People Adult], DimFear[Beat] = 1 ) + 0, "0" )
		displayFolder: P28
		lineageTag: 24db9294-8bcf-5662-84a0-80318676860d

	/// 9 -> 12
	measure 'Beat2 Hero' =
			VAR f = "Death (your own or a loved one’s)"
			RETURN
			    FORMAT ( CALCULATE ( [People Childhood], DimFear[Fear] = f ) + 0, "0" ) & " → "
			        & FORMAT ( CALCULATE ( [People Adult], DimFear[Fear] = f ) + 0, "0" )
		displayFolder: P28
		lineageTag: 0bd97ea5-a04d-5bd7-8334-730c542137b9

	/// 11 -> 42
	measure 'Beat3 Hero' =
			FORMAT ( CALCULATE ( [People Childhood], DimFear[Category] = "Performance & Future" ) + 0, "0" ) & " → "
			    & FORMAT ( CALCULATE ( [People Adult], DimFear[Category] = "Performance & Future" ) + 0, "0" )
		displayFolder: P28
		lineageTag: 8955b2d9-4be4-5f00-a79e-cf1392e9f3ce

	measure 'War Kept' = CALCULATE ( [People Kept], DimFear[Fear] = "War" )
		formatString: #,##0
		displayFolder: P28
		lineageTag: af22880d-eef7-52ea-84a7-0f75b173b4a7

	measure 'War Childhood' = CALCULATE ( [People Childhood], DimFear[Fear] = "War" )
		formatString: #,##0
		displayFolder: P28
		lineageTag: e5474c17-5f38-5778-9dd5-4eeebe1f6f9c

	measure 'Financial Child' = CALCULATE ( [People Childhood], DimFear[Fear] = "Financial insecurity/poverty" ) + 0
		formatString: #,##0
		displayFolder: P28
		lineageTag: 0ac80208-1818-5718-88ec-1cefbd4094f1

	measure 'Financial Adult' = CALCULATE ( [People Adult], DimFear[Fear] = "Financial insecurity/poverty" )
		formatString: #,##0
		displayFolder: P28
		lineageTag: aa5bb660-ed76-5c78-8e41-5eae197183e5

	measure 'Beat3 Note' =
			VAR k = [War Kept] + 0
			VAR c = [War Childhood] + 0
			RETURN
			    IF ( k = c && c > 0, "All " & k, k & " of " & c ) & " who feared war as children still do. "
			        & "The Hungry Ghost Festival burns paper money for the dead. Financial insecurity: "
			        & FORMAT ( [Financial Child], "0" ) & " → " & FORMAT ( [Financial Adult] + 0, "0" ) & "."
		displayFolder: P28
		lineageTag: 96a2e690-c941-5f93-8d9e-136407a5270c

	measure 'Beat3 Note 1' =
			VAR k = [War Kept] + 0
			VAR c = [War Childhood] + 0
			RETURN
			    IF ( k = c && c > 0, "All " & k, k & " of " & c ) & " who feared war as children still do."
		displayFolder: P28
		lineageTag: 0d7a732e-0ea4-56f7-90ee-e548234a8a0a

	measure 'Beat3 Note 2' = "The Hungry Ghost Festival burns paper money"
		displayFolder: P28
		lineageTag: 261b32fa-49ba-5ed1-9834-ede1eddd0714

	measure 'Beat3 Note 3' = "for the dead. Financial insecurity: " & FORMAT ( [Financial Child], "0" ) & " → " & FORMAT ( [Financial Adult] + 0, "0" ) & "."
		displayFolder: P28
		lineageTag: 7307ceb2-bb69-5b31-88ba-1abaea6ad416

	/// SVG markup (no data-URI prefix) for one dumbbell row: hollow ring = people as a child, filled dot = people now; scale 0-20 shared by beats I-III.
	measure 'Dumbbell Body' =
			VAR c = [People Childhood] + 0
			VAR a = [People Adult] + 0
			VAR maxV = 20 -- one fixed scale shared by the three beat tables
			VAR x0 = 14
			VAR x1 = 150
			VAR xc = ROUND ( x0 + MIN ( c, maxV ) / maxV * ( x1 - x0 ), 1 )
			VAR xa = ROUND ( x0 + MIN ( a, maxV ) / maxV * ( x1 - x0 ), 1 )
			VAR col = SWITCH ( SELECTEDVALUE ( DimFear[Beat] ), 1, "%233DE0D0", 2, "%23FF3D9A", 3, "%23FFB400", "%23A99BD6" )
			VAR up = a >= c
			RETURN
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 175 22' width='175' height='22'>"
			        & "<line x1='" & x0 & "' y1='11' x2='" & x1 & "' y2='11' stroke='%23A99BD6' stroke-opacity='.35'/>"
			        & "<line x1='" & xc & "' y1='11' x2='" & xa & "' y2='11' stroke='" & col & "' stroke-width='3'/>"
			        & "<circle cx='" & xc & "' cy='11' r='5.5' fill='%231E0F4A' stroke='%23FFF3DC' stroke-width='2'/>"
			        & "<circle cx='" & xa & "' cy='11' r='6.5' fill='" & col & "'/>"
			        & "<text x='" & IF ( up, xa + 10, xa - 10 ) & "' y='15' font-family='Segoe UI' font-size='12' font-weight='700' fill='%23FFF3DC' text-anchor='" & IF ( up, "start", "end" ) & "'>" & a & "</text>"
			        & "<text x='" & IF ( up, xc - 9, xc + 9 ) & "' y='15' font-family='Segoe UI' font-size='11' fill='%23A99BD6' text-anchor='" & IF ( up, "end", "start" ) & "'>" & c & "</text>"
			        & "</svg>"
		displayFolder: P28
		lineageTag: 13181995-a4de-5c97-ad8f-535bda396a78

	measure 'Dumbbell SVG' = "data:image/svg+xml;utf8," & [Dumbbell Body]
		displayFolder: P28
		lineageTag: 1bcb571a-9e41-5589-88c6-6fdd7fa9eed9
		dataCategory: ImageUrl

	/// SVG markup (no prefix): one circle per person who held the fear as a child; filled = still holds it.
	measure 'Kept Units Body' =
			VAR n = [People Childhood] + 0
			VAR k = [People Kept] + 0
			VAR dots =
			    CONCATENATEX (
			        GENERATESERIES ( 1, n ),
			        VAR x = 7 + ( [Value] - 1 ) * 14.5
			        RETURN
			            IF (
			                [Value] <= k,
			                "<circle cx='" & x & "' cy='11' r='5.5' fill='%23FF3D9A'/>",
			                "<circle cx='" & x & "' cy='11' r='5' fill='none' stroke='%23A99BD6' stroke-width='1.5'/>"
			            ),
			        "",
			        [Value]
			    )
			RETURN
			    IF ( n > 0, "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 205 22' width='205' height='22'>" & dots & "</svg>" )
		displayFolder: P28
		lineageTag: f0bed5a7-5039-5fd5-b2d5-b2f6bcbc5753

	measure 'Kept Units SVG' = IF ( NOT ISBLANK ( [Kept Units Body] ), "data:image/svg+xml;utf8," & [Kept Units Body] )
		displayFolder: P28
		lineageTag: 4178e646-7291-5edb-a5ac-a3d84f92633b
		dataCategory: ImageUrl

	/// Top 5 beat-I fears by change in people (largest drop first; ties on people as a child).
	measure 'B1 Order' =
			VAR score = [Change People] * 100 - [People Childhood]
			VAR r =
			    RANKX (
			        FILTER ( ALL ( DimFear ), DimFear[Beat] = 1 ),
			        CALCULATE ( [Change People] * 100 - [People Childhood] ),
			        score,
			        ASC,
			        SKIP
			    )
			RETURN
			    IF ( HASONEVALUE ( DimFear[Fear] ) && SELECTEDVALUE ( DimFear[Beat] ) = 1 && r <= 5, r )
		formatString: 0
		displayFolder: P28
		lineageTag: f6f1ae75-6f3a-5ae4-94e5-35778c1555a9

	measure 'B1 Dumbbell' = IF ( NOT ISBLANK ( [B1 Order] ), "data:image/svg+xml;utf8," & [Dumbbell Body] )
		displayFolder: P28
		lineageTag: 6134812d-078a-5613-a4a6-91a6e3c5383a
		dataCategory: ImageUrl

	measure 'B2 Order' = SWITCH ( SELECTEDVALUE ( DimFear[Fear] ), "Death (your own or a loved one’s)", 1, "Cancer or another serious diagnosis", 2 )
		formatString: 0
		displayFolder: P28
		lineageTag: 46f16a88-e449-51da-881c-236e123b6bb1

	measure 'B2 Dumbbell' = IF ( NOT ISBLANK ( [B2 Order] ), "data:image/svg+xml;utf8," & [Dumbbell Body] )
		displayFolder: P28
		lineageTag: 621e8567-cf19-5c94-b4c9-b7480ea6ed65
		dataCategory: ImageUrl

	/// Top 3 by people kept among fears held by at least 10 people as children.
	measure 'Sticky Order' =
			VAR r =
			    RANKX ( FILTER ( ALL ( DimFear ), [People Childhood] >= 10 ), [People Kept] + 0, [People Kept] + 0, DESC, SKIP )
			RETURN
			    IF ( HASONEVALUE ( DimFear[Fear] ) && [People Childhood] >= 10 && r <= 3, r )
		formatString: 0
		displayFolder: P28
		lineageTag: 5aef82cc-dfe5-584b-ba6d-f55ae0da0ed8

	measure 'Sticky Count' = IF ( NOT ISBLANK ( [Sticky Order] ), FORMAT ( [People Kept] + 0, "0" ) & " of " & FORMAT ( [People Childhood], "0" ) )
		displayFolder: P28
		lineageTag: d6dae21c-d3dc-5f8b-a234-01e5b37c955a

	measure 'Sticky Units' = IF ( NOT ISBLANK ( [Sticky Order] ), "data:image/svg+xml;utf8," & [Kept Units Body] )
		displayFolder: P28
		lineageTag: 968c6938-12b3-5343-8264-ca2588c0cdd5
		dataCategory: ImageUrl

	/// Top 5 beat-III fears by change in people (largest rise first).
	measure 'B3 Order' =
			VAR score = -( [Change People] * 100 + [People Childhood] )
			VAR r =
			    RANKX (
			        FILTER ( ALL ( DimFear ), DimFear[Beat] = 3 ),
			        CALCULATE ( -( [Change People] * 100 + [People Childhood] ) ),
			        score,
			        ASC,
			        SKIP
			    )
			RETURN
			    IF ( HASONEVALUE ( DimFear[Fear] ) && SELECTEDVALUE ( DimFear[Beat] ) = 3 && r <= 5, r )
		formatString: 0
		displayFolder: P28
		lineageTag: 4f1e22b9-6fd4-535a-8677-9f4b3e1ddbfd

	measure 'B3 Dumbbell' = IF ( NOT ISBLANK ( [B3 Order] ), "data:image/svg+xml;utf8," & [Dumbbell Body] )
		displayFolder: P28
		lineageTag: 5be5364b-c5bd-519b-b993-74d4c40578f4
		dataCategory: ImageUrl

	measure 'Nightmare Respondents' = DISTINCTCOUNT ( DataNightmare[ResponseKey] )
		formatString: #,##0
		displayFolder: P28
		lineageTag: 50b21c73-ea57-53ab-af03-9a079e4c33f4

	measure 'Nightmare Share' = DIVIDE ( [Nightmare Respondents], CALCULATE ( [Nightmare Respondents], REMOVEFILTERS ( DataNightmare ) ) )
		formatString: 0%
		displayFolder: P28
		lineageTag: 889afd63-9d94-5bbd-b496-585efc4f25db

	/// ALL names the sort-by column too, or every bar ranks 1.
	measure 'Nightmare Rank' =
			RANKX (
			    ALL ( DataNightmare[Nightmare], DataNightmare[NightmareOrder] ),
			    [Nightmare Respondents],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: P28
		lineageTag: bbdea086-181f-5790-85b0-4844e7ec6768

	measure 'Nightmare Bar Color' = IF ( [Nightmare Rank] = 1, "#C8006E", "#5B2DBF" )
		displayFolder: P28
		lineageTag: 1b3a9013-5b9e-5a8a-8dc6-df18de350151

	measure 'Ritual Caption' = SELECTEDVALUE ( DataNightmare[RitualCaption] )
		displayFolder: P28
		lineageTag: 075d9655-c44c-5da8-8249-3433d0833969

	measure 'Tool Users' = DISTINCTCOUNT ( FabricTool[ResponseKey] )
		formatString: #,##0
		displayFolder: P28
		lineageTag: efdc7929-6612-516c-8bd9-4a66872607ad

	/// Respondents who named at least one Fabric tool (97).
	measure 'Fabric Users' = CALCULATE ( DISTINCTCOUNT ( FabricTool[ResponseKey] ), KEEPFILTERS ( FabricTool[Tool] <> "None yet" ) )
		formatString: #,##0
		displayFolder: P28
		lineageTag: 89e33f50-633b-5e82-a11b-d315565a7e56

	measure 'Europe Childhood' = CALCULATE ( [People Childhood], DimCountry[Continent] = "Europe" )
		formatString: #,##0
		displayFolder: P28
		lineageTag: d39419fa-ab6c-536c-97ce-83a8573a73ea

	measure 'Europe Now' = CALCULATE ( [People Adult], DimCountry[Continent] = "Europe" )
		formatString: #,##0
		displayFolder: P28
		lineageTag: 458f40b4-2dfd-5867-a821-bc0cb9f757b7

	measure 'Honesty 1' = FORMAT ( [Respondents], "0" ) & " people, self-reported: it reflects who took part, not everyone."
		displayFolder: P28
		lineageTag: f60db0c3-3953-5871-8ca5-59993edd03ba

	measure 'Honesty 2' =
			VAR mn = CALCULATE ( [Number of Respondents], DimGender[Gender] = "Male" ) + 0
			VAR wm = CALCULATE ( [Number of Respondents], DimGender[Gender] = "Female" ) + 0
			RETURN
			    mn & " men · " & wm & " women · " & ( [Respondents] - mn - wm ) & " another gender or preferred not to say."
		displayFolder: P28
		lineageTag: a6041150-c560-590d-bc69-ca41ab92a5d7

	measure 'Honesty 3' =
			VAR a = CALCULATE ( [Number of Respondents], DimAgeGroup[AgeGroup] IN { "25" & UNICHAR ( 8211 ) & "34", "35" & UNICHAR ( 8211 ) & "44" } ) + 0
			RETURN
			    a & " of " & [Respondents] & " aged 25–44 · about two-thirds in Europe (" & [Europe Childhood] & " as children, " & [Europe Now] & " now)."
		displayFolder: P28
		lineageTag: 737fdfad-4e5d-52df-9920-71f58ab5b394

	measure 'Honesty 4' = "Up to 3 fears per life stage; counts are people unless marked picks."
		displayFolder: P28
		lineageTag: 3458f127-5ae6-5f11-8741-03cf6ec4543f

	measure 'Honesty 5' =
			VAR t1 = CALCULATE ( [Tool Users], FabricTool[Tool] = "Power BI reports" )
			VAR t2 = CALCULATE ( [Tool Users], FabricTool[Tool] = "Power BI semantic models" )
			VAR t3 = CALCULATE ( [Tool Users], FabricTool[Tool] = "Lakehouses" )
			RETURN
			    [Fabric Users] & " of " & [Respondents] & " use Fabric: Power BI reports " & t1 & ", semantic models " & t2 & ", Lakehouses " & t3 & "."
		displayFolder: P28
		lineageTag: 8774494a-7b03-5e2c-9a26-b220585934e3

	measure 'TT Outgrow Sentence' =
			VAR f = LOWER ( SELECTEDVALUE ( DimFear[FearShort] ) )
			VAR c = [People Childhood] + 0
			VAR a = [People Adult] + 0
			VAR k = [People Kept] + 0
			RETURN
			    IF (
			        HASONEVALUE ( DimFear[Fear] ),
			        c & IF ( c = 1, " person", " people" ) & " feared " & f & " as children; " & a & " do now. "
			            & IF ( k = 0, "None kept it.", k & " kept it." )
			    )
		displayFolder: P28
		lineageTag: 0993e2b7-1ab2-5d51-b91b-cc0e2e10183b

	measure 'TT Keep Sentence' =
			VAR f = LOWER ( SELECTEDVALUE ( DimFear[FearShort] ) )
			VAR c = [People Childhood] + 0
			VAR k = [People Kept] + 0
			RETURN
			    IF ( HASONEVALUE ( DimFear[Fear] ) && c > 0,
			        k & " of " & c & " still fear " & f & " (" & FORMAT ( DIVIDE ( k, c ), "0%" ) & ")." )
		displayFolder: P28
		lineageTag: db2cd702-70fb-58da-abd7-00e04f7a7936

	measure 'TT GrowInto Sentence' =
			VAR f = LOWER ( SELECTEDVALUE ( DimFear[FearShort] ) )
			VAR a = [People Adult] + 0
			VAR k = [People Kept] + 0
			RETURN
			    IF ( HASONEVALUE ( DimFear[Fear] ),
			        a & IF ( a = 1, " person fears ", " people fear " ) & f & " now; " & ( a - k ) & " of them did not as children." )
		displayFolder: P28
		lineageTag: 463f1abb-cfc4-54f6-b224-d9f20def8db5

	measure 'TT Nightmare Sentence' =
			VAR n = [Nightmare Respondents]
			VAR full = SELECTEDVALUE ( DataNightmare[dataNightmare] )
			VAR tools =
			    TOPN (
			        3,
			        FILTER ( VALUES ( FabricTool[Tool] ), FabricTool[Tool] <> "None yet" ),
			        [Tool Users], DESC,
			        FabricTool[Tool], ASC
			    )
			VAR toolList =
			    CONCATENATEX ( tools, FabricTool[Tool] & " (" & [Tool Users] & ")", ", ", [Tool Users], DESC, FabricTool[Tool], ASC )
			RETURN
			    IF ( HASONEVALUE ( DataNightmare[Nightmare] ),
			        n & " of " & [Respondents] & " chose: " & full & ". Their most-used Fabric tools: " & toolList & "." )
		displayFolder: P28
		lineageTag: 616135b7-78d7-5eab-a8e2-57d54288edf3

	/// People who named at least one real fear as a child (excludes None of these / Prefer not to answer / Something else). Ignores any DimFear[Beat] filter.
	measure 'People Naming A Fear Childhood' = CALCULATE ( [People Childhood], DimFear[Beat] IN { 1, 2, 3 } )
		formatString: #,##0
		displayFolder: P28
		lineageTag: 40ac9f59-e108-5e75-acc6-13f049cf0270

	/// People who named at least one real fear as an adult (excludes None of these / Prefer not to answer / Something else). Ignores any DimFear[Beat] filter.
	measure 'People Naming A Fear Adult' = CALCULATE ( [People Adult], DimFear[Beat] IN { 1, 2, 3 } )
		formatString: #,##0
		displayFolder: P28
		lineageTag: a07cc28b-2424-5ca9-9093-d72b47be84c2

